# Two variants: 64-bit (-m64, ELFv1, the default; MULTILIB_DEFAULTS in
# xenon64.h lists m64) in the plain library directories, and 32-bit
# (-m32, SysV ABI, built with -mcpu=xenon and so with -mpowerpc64) in the
# "32" subdirectories, the layout of the old Xenon toolchain, whose
# libxenon is built -m32.
MULTILIB_OPTIONS	= m32
MULTILIB_DIRNAMES	= 32
MULTILIB_MATCHES	=
MULTILIB_EXCEPTIONS	=
